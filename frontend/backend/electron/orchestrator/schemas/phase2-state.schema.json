{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirov5.local/schemas/phase2-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "phase",
    "clientStores",
    "serverState",
    "stateMachines",
    "invariants",
    "status"
  ],
  "properties": {
    "policyVersion": { "const": "gold-5.0.0" },
    "phase": { "const": "phase2B_StateContract" },
    "clientStores": { "type": "array", "items": { "$ref": "#/$defs/store" } },
    "serverState": { "type": "array" },
    "stateMachines": { "type": "array", "items": { "$ref": "#/$defs/stateMachine" } },
    "invariants": { "type": "array" },
    "status": { "enum": ["complete", "needs_review"] }
  },
  "$defs": {
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stateFields", "actions"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "entityId": { "type": "string" },
        "stateFields": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "states", "initialState", "transitions"],
      "properties": {
        "id": { "type": "string" },
        "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "initialState": { "type": "string" },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "from", "to"],
            "properties": {
              "event": { "type": "string" },
              "from": { "type": "array", "items": { "type": "string" } },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
