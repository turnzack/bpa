## 🎮 Implémentation Détaillée

### Étape 1 : Grille en Damier
```javascript
function createCheckerboardGrid(size, divisions) {
    const gridHelper = new THREE.GridHelper(size, divisions, 0x444444, 0x222222);
    scene.add(gridHelper);
    
    // Damier au sol
    const geometry = new THREE.PlaneGeometry(size, size);
    const material = new THREE.MeshStandardMaterial({
        map: createCheckerboardTexture(),
        side: THREE.DoubleSide
    });
    const plane = new THREE.Mesh(geometry, material);
    plane.rotation.x = -Math.PI / 2;
    scene.add(plane);
}

function createCheckerboardTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    
    const tileSize = 64;
    for (let i = 0; i < 8; i++) {
        for (let j = 0; j < 8; j++) {
            ctx.fillStyle = (i + j) % 2 === 0 ? '#ffffff' : '#cccccc';
            ctx.fillRect(i * tileSize, j * tileSize, tileSize, tileSize);
        }
    }
    
    return new THREE.CanvasTexture(canvas);
}
```

### Étape 2 : Chargement FBX
```javascript
const fbxLoader = new THREE.FBXLoader();

function loadModel(path, position) {
    fbxLoader.load(path, (fbx) => {
        fbx.position.set(...position);
        fbx.scale.setScalar(0.01); // Ajuster l'échelle
        scene.add(fbx);
        
        // Si animations présentes
        if (fbx.animations.length > 0) {
            const mixer = new THREE.AnimationMixer(fbx);
            mixers.push(mixer);
        }
    });
}
```

### Étape 3 : Système d'Animations
```javascript
class AnimationController {
    constructor(character) {
        this.character = character;
        this.mixer = new THREE.AnimationMixer(character);
        this.animations = {};
        this.currentAction = null;
    }
    
    addAnimation(name, fbxPath) {
        fbxLoader.load(fbxPath, (fbx) => {
            const clip = fbx.animations[0];
            const action = this.mixer.clipAction(clip);
            this.animations[name] = action;
        });
    }
    
    play(name, fadeTime = 0.2) {
        const action = this.animations[name];
        if (!action) return;
        
        if (this.currentAction && this.currentAction !== action) {
            this.currentAction.fadeOut(fadeTime);
        }
        
        action.reset().fadeIn(fadeTime).play();
        this.currentAction = action;
    }
}
```

### Étape 4 : Joystick Virtuel
```javascript
class VirtualJoystick {
    constructor(container) {
        this.container = container;
        this.active = false;
        this.position = { x: 0, y: 0 };
        
        this.createJoystick();
        this.setupEvents();
    }
    
    createJoystick() {
        this.base = document.createElement('div');
        this.base.className = 'joystick-base';
        
        this.stick = document.createElement('div');
        this.stick.className = 'joystick-stick';
        
        this.base.appendChild(this.stick);
        this.container.appendChild(this.base);
    }
    
    setupEvents() {
        this.base.addEventListener('touchstart', (e) => {
            this.active = true;
        });
        
        this.base.addEventListener('touchmove', (e) => {
            if (!this.active) return;
            
            const touch = e.touches[0];
            const rect = this.base.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            
            let deltaX = touch.clientX - centerX;
            let deltaY = touch.clientY - centerY;
            
            // Limiter au rayon
            const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
            const maxDistance = rect.width / 2;
            
            if (distance > maxDistance) {
                deltaX = (deltaX / distance) * maxDistance;
                deltaY = (deltaY / distance) * maxDistance;
            }
            
            this.position.x = deltaX / maxDistance;
            this.position.y = -deltaY / maxDistance;
            
            this.stick.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
        });
        
        this.base.addEventListener('touchend', () => {
            this.active = false;
            this.position = { x: 0, y: 0 };
            this.stick.style.transform = 'translate(0, 0)';
        });
    }
}
```

### Étape 5 : Mode Game
```javascript
class GameMode {
    constructor(scene, character, animController) {
        this.scene = scene;
        this.character = character;
        this.animController = animController;
        this.joystick = new VirtualJoystick(document.body);
        
        this.setupCamera();
        this.setupButtons();
    }
    
    setupCamera() {
        this.camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        this.cameraOffset = new THREE.Vector3(0, 3, -5);
    }
    
    update(deltaTime) {
        const input = this.joystick.position;
        
        // Déplacement
        if (Math.abs(input.x) > 0.1 || Math.abs(input.y) > 0.1) {
            const speed = this.isRunning ? 5 : 2;
            const direction = new THREE.Vector3(input.x, 0, input.y).normalize();
            
            this.character.position.add(direction.multiplyScalar(speed * deltaTime));
            
            // Rotation du personnage
            const angle = Math.atan2(direction.x, direction.z);
            this.character.rotation.y = angle;
            
            // Animation
            if (this.isRunning) {
                this.animController.play('run');
            } else {
                this.animController.play('walk');
            }
        } else {
            this.animController.play('idle');
        }
        
        // Caméra suit le personnage
        const targetPos = this.character.position.clone().add(this.cameraOffset);
        this.camera.position.lerp(targetPos, 0.1);
        this.camera.lookAt(this.character.position);
    }
}
```

